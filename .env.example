# ==============================================================================
# ClinicScraper Environment Variables
# Любой параметр из config/search_config.json может быть переопределен через .env
# ==============================================================================

# --- Gemini API ---
# Один или несколько ключей через запятую (для параллельной ротации)
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_RPM=14
GEMINI_TPM=250000
GEMINI_CONCURRENCY=4
GEMINI_MAX_RETRIES=3
GEMINI_BACKOFF_SECONDS=5.0
GEMINI_MAX_PROMPT_CHARS=28000

# --- 2GIS Harvester ---
USE_2GIS=true
PUBLIC_KEYS_2GIS=ruzhub8994,rurbbn3446,ruregt3044
MAX_PAGES_2GIS=5
DGIS_PAGE_SIZE=50
DGIS_REQUEST_DELAY=0.35
DGIS_TIMEOUT=15

# --- Yandex Maps Harvester ---
USE_YANDEX=true
MAX_RESULTS_YANDEX=70
YANDEX_SCROLL_COUNT=7
YANDEX_LOAD_TIMEOUT_MS=35000

# --- SmartCrawler ---
CRAWLER_CONCURRENCY=8
CRAWLER_TIMEOUT=15
CRAWLER_MAX_PAGES=4
CRAWLER_MAX_TEXT_CHARS=35000
CRAWLER_MAX_EMAILS=3
USE_PLAYWRIGHT_FALLBACK=true
PLAYWRIGHT_TIMEOUT_MS=20000
PLAYWRIGHT_WAIT_MS=2500

# --- Pipeline & Paths ---
CITY=Хабаровск
CHECKPOINT_INTERVAL=15
DATA_DIR=data
OUTPUT_DIR=output
CACHE_DIR=cache
